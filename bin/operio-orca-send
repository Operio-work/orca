#!/usr/bin/env node
'use strict';
// operio-orca-send — let an agent message the agents it is linked with in ORCA.
//   operio-orca-send <agent> "message"     send (queued until the other agent is idle)
//   operio-orca-send <agent> -             read the message from stdin
//   operio-orca-send --list                who you are linked with, and how
//   operio-orca-send --last <agent> [n]    the other agent's latest output (n lines, default 80)
// <agent> is a name (e.g. sable) or a pane id (w1:p7). Only linked agents can be reached;
// links are made by a person in ORCA. Talks to the ORCA server over a local socket
// (~/.config/operio-orca/agents.sock), which works out which agent you are from your process.

const http = require('http');

const SOCK = require('../lib/config').load().AGENT_SOCK;
const ERRORS = {
  not_an_agent: 'this shell is not inside an ORCA agent pane',
  not_linked: 'you are not linked with that agent — a person links agents in ORCA',
  no_such_agent: 'no agent by that name (operio-orca-send --list shows your links)',
  ambiguous: 'two agents share that name — use its pane id (operio-orca-send --list)',
  rate_limited: 'link paused: too many messages this hour. A person has been alerted; stop and wait.',
  too_long: 'message too long (max 4000 characters)',
  empty: 'empty message',
  self: 'that is you',
};

function call(method, p, body) {
  return new Promise((resolve, reject) => {
    const data = body ? JSON.stringify(body) : null;
    const req = http.request({ socketPath: SOCK, method, path: p, headers: data ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } : {} }, res => {
      let buf = '';
      res.on('data', c => { buf += c; });
      res.on('end', () => {
        let j = {};
        try { j = JSON.parse(buf); } catch { /* not JSON */ }
        if (res.statusCode >= 400) reject(new Error(ERRORS[j.error] || j.error || `HTTP ${res.statusCode}`));
        else resolve(j);
      });
    });
    req.on('error', e => reject(new Error(e.code === 'ENOENT' || e.code === 'ECONNREFUSED' ? 'ORCA is not running (operio-orca start)' : e.message)));
    if (data) req.write(data);
    req.end();
  });
}

const readStdin = () => new Promise(r => { let s = ''; process.stdin.setEncoding('utf8'); process.stdin.on('data', c => { s += c; }); process.stdin.on('end', () => r(s)); });

async function main() {
  const args = process.argv.slice(2);
  const pid = process.pid;
  if (!args.length || args[0] === '-h' || args[0] === '--help') {
    console.log('usage: operio-orca-send <agent> "message" | operio-orca-send <agent> - | operio-orca-send --list | operio-orca-send --last <agent> [lines]');
    return;
  }
  if (args[0] === '--list') {
    const r = await call('GET', `/links?pid=${pid}`);
    console.log(`you are ${r.me.name} (${r.me.pane})`);
    if (!r.links.length) console.log('no links yet');
    for (const l of r.links) console.log(`  ${l.name.padEnd(20)} ${l.relation.padEnd(18)} ${l.status}`);
    return;
  }
  if (args[0] === '--last') {
    if (!args[1]) throw new Error('usage: operio-orca-send --last <agent> [lines]');
    const r = await call('GET', `/last?pid=${pid}&of=${encodeURIComponent(args[1])}&lines=${Number(args[2]) || 80}`);
    console.log(`── ${r.name} (${r.status}) ──`);
    process.stdout.write(r.text.endsWith('\n') ? r.text : r.text + '\n');
    return;
  }
  const [to, ...rest] = args;
  let text = rest.join(' ');
  if (text === '-') text = await readStdin();
  if (!text.trim()) throw new Error('empty message');
  const r = await call('POST', '/send', { pid, to, text });
  console.log(r.queued ? `queued for ${r.to} (${r.status}) — delivered when it is idle` : `sent to ${r.to}`);
}

main().catch(e => { console.error('operio-orca-send: ' + e.message); process.exit(1); });
