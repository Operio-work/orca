{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://make.operio.work/catalog/schema.json",
  "title": "ORCA routine catalog",
  "description": "The single source the make.operio.work site renders: free packs that ship in routines/ and the routines Operio runs for you. No prices.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "cta", "entries"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cta": { "$ref": "#/$defs/text" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "\\S" },
        "es": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "\\S" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tier", "verticals", "name", "problem", "outcome", "how", "trigger", "approval", "tools"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" },
        "tier": { "enum": ["free", "managed"] },
        "verticals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["restaurant", "clinic", "real-estate", "tourism", "retail", "services", "any"] }
        },
        "name": { "$ref": "#/$defs/text" },
        "problem": { "$ref": "#/$defs/text" },
        "outcome": { "$ref": "#/$defs/text" },
        "how": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "es"],
          "properties": { "en": { "$ref": "#/$defs/steps" }, "es": { "$ref": "#/$defs/steps" } }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {
            "kind": { "enum": ["cron", "event", "on-demand"] },
            "summary": { "$ref": "#/$defs/text" }
          }
        },
        "approval": { "$ref": "#/$defs/text" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 40 }
        },
        "upgrade": { "$ref": "#/$defs/text" },
        "pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
      },
      "if": { "properties": { "tier": { "const": "free" } } },
      "then": { "required": ["pack"] },
      "else": { "not": { "anyOf": [{ "required": ["pack"] }, { "required": ["upgrade"] }] } }
    }
  }
}
